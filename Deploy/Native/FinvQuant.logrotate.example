# =====================================================================
# FinvQuant Native：日志轮转示例（logrotate）
#
# 安装（可选）：
#   sudo cp /data/App/FinvQuant/Deploy/FinvQuant.logrotate.example \
#           /etc/logrotate.d/finvquant
#   sudo chmod 0644 /etc/logrotate.d/finvquant
#   sudo logrotate -d /etc/logrotate.d/finvquant   # 干跑校验
#
# 说明：
#   - 应用以追加方式持有 finvquant.log，未实现 SIGHUP 重开，使用 copytruncate；
#   - 路径需与 FINV_LOG_DIR 一致（默认 <PREFIX>/Logs）；
#   - 保留 14 份、单份超过 50M 提前轮转、压缩历史文件。
# =====================================================================

/data/App/FinvQuant/Logs/*.log {
    daily
    rotate 14
    size 50M
    missingok
    notifempty
    compress
    delaycompress
    copytruncate
    su finvquant finvquant
}
