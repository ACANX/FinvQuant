# =====================================================================
# FinvQuant Native（宿主直装）环境变量模板
#
# 使用方式：
#   sudo cp Deploy/Native/FinvQuant.env.example /etc/finvquant/finvquant.env
#   sudo chmod 600 /etc/finvquant/finvquant.env
#   sudo vi /etc/finvquant/finvquant.env      # 修改密码等敏感项
#
# 键名与容器方式（Deploy/Docker/.env.example）保持一致，差异仅在连接地址：
#   容器方式：FINV_PG_HOST=postgres、FINV_REDIS_ADDR=redis:6379
#   本方式  ：本机直连 127.0.0.1
# 本文件由 systemd 通过 EnvironmentFile 加载，格式为 KEY=VALUE（不要加 export、不要加引号）。
# =====================================================================

# ---------- 服务端 ----------
# 只监听本机，由 Nginx 反向代理对外；如需直连公网可改为 0.0.0.0（不推荐）
FINV_SERVER_HOST=127.0.0.1
FINV_SERVER_PORT=16001
FINV_WEB_PORT=16002
# gin 运行模式：release / debug
FINV_MODE=release

# ---------- PostgreSQL 18 ----------
FINV_PG_HOST=127.0.0.1
FINV_PG_PORT=5432
FINV_PG_USER=finv
FINV_PG_PASSWORD=CHANGE_ME
FINV_PG_DATABASE=finv

# ---------- Redis 8 ----------
FINV_REDIS_ADDR=127.0.0.1:6379
# 未设置密码时留空
FINV_REDIS_PASSWORD=
FINV_REDIS_DB=0

# ---------- 数据库迁移目录 ----------
# 迁移脚本随发行包提供，安装脚本会复制到这里；服务启动时自动应用未执行的版本
FINV_MIGRATIONS_DIR=/etc/finvquant/Migrations
