# =====================================================================
# FinvQuant Native（宿主直装）环境变量模板
#
# 安装后的位置：/data/App/FinvQuant/finvquant.env（权限 600）
# 由 Install.sh 自动复制并按实际安装根目录改写路径、随机生成数据库密码；
# 如手工安装：
#   sudo cp Deploy/Native/FinvQuant.env.example /data/App/FinvQuant/finvquant.env
#   sudo chmod 600 /data/App/FinvQuant/finvquant.env
#   sudo vi /data/App/FinvQuant/finvquant.env      # 修改密码等敏感项
#
# 键名与容器方式（Deploy/Docker/.env.example）保持一致，差异仅在连接地址：
#   容器方式：FINV_PG_HOST=postgres、FINV_REDIS_ADDR=redis:6379
#   本方式  ：本机直连 127.0.0.1
# 本文件由 systemd 通过 EnvironmentFile 加载，格式为 KEY=VALUE（不要加 export、不要加引号）。
# =====================================================================

# ---------- 服务端 ----------
# 只监听本机，由 Nginx 反向代理对外；如需直连公网可改为 0.0.0.0（不推荐）
FINV_SERVER_HOST=127.0.0.1
FINV_SERVER_PORT=16001
FINV_WEB_PORT=16002
# gin 运行模式：release / debug
FINV_MODE=release

# ---------- PostgreSQL 18 ----------
FINV_PG_HOST=127.0.0.1
FINV_PG_PORT=5432
FINV_PG_USER=finv
FINV_PG_PASSWORD=CHANGE_ME
FINV_PG_DATABASE=finv

# ---------- Redis 8 ----------
FINV_REDIS_ADDR=127.0.0.1:6379
# 未设置密码时留空
FINV_REDIS_PASSWORD=
FINV_REDIS_DB=0

# ---------- 日志（Native）----------
# 日志目录：标准库日志与 gin 访问日志同时写入该目录（journald 仍保留）。
# 留空则仅输出到 journald；安装脚本默认创建 <PREFIX>/Log。
# 单文件超过 FINV_LOG_MAX_MB 后切分为 FinvQuant-yyyyMMdd-NN.log（NN 从 01 自增），
# 跨日按 FinvQuant-yyyyMMdd.tar.gz 归档并删除对应 .log。
FINV_LOG_DIR=/data/App/FinvQuant/Log
FINV_LOG_FILE=FinvQuant.log
FINV_LOG_MAX_MB=10

# ---------- 数据库迁移目录 ----------
# 迁移脚本随发行包提供，安装脚本会复制到这里；服务启动时自动应用未执行的版本
FINV_MIGRATIONS_DIR=/data/App/FinvQuant/Deploy/Migrations

# ---------- 行情月归档导出与上传（可选）----------
# 目录统一落在安装根目录下，与容器方式的 /data/App/FinvQuant/Export 一致
FINV_QUOTE_DEDUB_OUTPUT_DIR=/data/App/FinvQuant/Export
FINV_QUOTE_DEDUB_UPLOAD_DIR=/data/App/FinvQuant/Export/Upload
# 上传方式：none（仅本地导出）/ dir（写入上传目录）/ http（PUT 到远端）
FINV_QUOTE_DEDUB_UPLOAD_MODE=none

# ---------- 外部 OpenAPI（/OpenAPI/V1，可选）----------
# 静态访问密钥（需求 10787，预留）：当前版本 /OpenAPI/V1 **暂不鉴权**（需求 10790），
# 该配置项暂不生效；API Key 体系落地后启用，由 sys.sys_open_api_key 替代。
FINV_OPENAPI_KEY=
