# FinvQuant 部署环境变量示例（复制为 .env 后按需修改）
#   cp Deploy/.env.example Deploy/.env
#   docker compose --env-file Deploy/.env up -d

# PostgreSQL 18
FINV_PG_USER=finv
FINV_PG_PASSWORD=finvquant
FINV_PG_DATABASE=finv
# 宿主访问 PG 端口（默认 5432；PG 客户端连接 localhost:5432，
# 如本地已占 5432 可改为 5433 等其他端口）
FINV_PG_EXPOSE_PORT=5432

# PostgreSQL 数据目录（映射到 Docker 宿主机文件系统，容器重建不丢数据）
# Windows 示例：D:\Dev\Docker\HostFileSystem\FinvQuant\PostgreSQL
# Linux/macOS 示例：/data/finvquant/postgresql
# 未设置时默认使用 Compose 项目目录下的 ./pgdata
FINV_PG_DATA_DIR=D:/Dev/Docker/HostFileSystem/FinvQuant/PostgreSQL

# Redis 8
FINV_REDIS_PASSWORD=
# 宿主访问 Redis 端口（默认 6380）
FINV_REDIS_EXPOSE_PORT=6380

# 镜像 tag（latest / 版本号）
FINV_IMAGE_TAG=latest

# 容器名（默认 finvquant；如与其他容器冲突可自定义）
FINV_CONTAINER_NAME=finvquant

# compose 项目名（默认 finvquant；影响命名卷前缀，如 finvquant_finvquant-redisdata）
FINV_PROJECT_NAME=finvquant

# PostgreSQL / Redis 容器名（默认 fq-postgres / fq-redis）
FINV_PG_CONTAINER_NAME=fq-postgres
FINV_REDIS_CONTAINER_NAME=fq-redis

# 时区
TZ=Asia/Shanghai

# ---------------------------------------------------------------------
# 证券行情月归档导出与上传（详见 Docs/Refactor/2610-005-FinvQuoteDeDubExportUpload.md）
# ---------------------------------------------------------------------
# 总开关：false 时只提供运维接口，不自动调度 10 个 Job
FINV_QUOTE_DEDUB_ENABLED=false
FINV_QUOTE_DEDUB_TIMEZONE=Asia/Shanghai
# 宿主机上的导出/上传目录（映射到容器 /data/App/FinvQuant/Export）
FINV_QUOTE_DEDUB_HOST_DIR=D:/Dev/Docker/HostFileSystem/FinvQuant/Export
# 容器内导出/上传根目录，必须位于上面的挂载目录下
FINV_QUOTE_DEDUB_OUTPUT_DIR=/data/App/FinvQuant/Export
FINV_QUOTE_DEDUB_UPLOAD_DIR=/data/App/FinvQuant/Export/Upload
# 导出低峰窗口已迁至数据库配置 sys.sys_config 20006（格式 HH:MM:SS|HH:MM:SS），
# 通过接口 PUT /API/V1/Meta/Finv/Quote/DeDup/Settings/Window 在线修改，
# 环境变量 FINV_QUOTE_DEDUB_WINDOW_START/_END 已废弃（不再读取）。
FINV_QUOTE_DEDUB_PAGE_SIZE=10000
# 上传实现：none（不启用）/ dir（目录或 NAS 挂载）/ http（HTTP PUT 网关）
# 注：上传到 GitHub 仓库由库内 sys_config 20002/20003/20004 驱动（20002='1' 时优先
#    于本项），不需要把本项改为 github。
FINV_QUOTE_DEDUB_UPLOAD_MODE=none
FINV_QUOTE_DEDUB_UPLOAD_PREFIX=
# 远端目录布局：by_security（默认，{region}_{market}/{usc}/文件名）/ flat（仅文件名，旧行为）
FINV_QUOTE_DEDUB_UPLOAD_LAYOUT=by_security
# GitHub API 端点（可空，默认 https://api.github.com；GitHub Enterprise 可覆盖）
FINV_QUOTE_DEDUB_UPLOAD_GITHUB_API_BASE=
# 主表旧数据清理（默认关闭，需全链路成功确认后手动开启）
# 主表行情数据清理改由系统配置 sys.sys_config 20007 承载（1-上传成功后立即删除/0-保留），
# 环境变量 FINV_QUOTE_DEDUB_PURGE_MAIN_ENABLED / _PURGE_MAIN_MONTHS 已废弃（不再读取）。
